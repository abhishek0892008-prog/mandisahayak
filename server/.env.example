# FarmQueue backend — environment template
#
# Copy to server/.env and fill in. Never commit the filled copy.
# Phase 2 (database + migrations) needs only DATABASE_URL. The remaining
# variables are listed as placeholders for the phases that introduce them and
# are deliberately left without values.

# ---------------------------------------------------------------------------
# Phase 2 — required now
# ---------------------------------------------------------------------------

# PostgreSQL 13 or newer; 16 is the target version.
# The migrations create the btree_gist extension, which requires a role with
# sufficient privilege (superuser, or a role granted pg_create_extension rights
# in your environment).
DATABASE_URL=postgres://farmqueue_app:CHANGE_ME@localhost:5432/farmqueue

# Name of the least-privilege application role. 0010_governance.sql revokes
# UPDATE/DELETE/TRUNCATE on audit_logs from this role if it exists. If your
# deployment uses a different name, edit the DO block in that migration.
FARMQUEUE_APP_ROLE=farmqueue_app

# ---------------------------------------------------------------------------
# Later phases — placeholders only, no values assigned yet
# ---------------------------------------------------------------------------

# Phase 5 (authentication)
# OTP_PEPPER=
# SESSION_SECRET=
# DEMO_MODE=false
# DEV_TOOLS_TOKEN=

# Phase 9 (queue). CONFIGURED operational tuning, not government data.
# How soon the server tells a queue client to poll again. The queue rate limits
# are derived from this value, so lowering it materially means revisiting them.
# QUEUE_POLL_AFTER_SECONDS=5
#
# NOT IMPLEMENTED — architecture §14.4 describes an in-process memo and a
# recompute worker. Phase 9 computes from committed state on every request
# instead; see docs/phase-9-report.md. These keys are read by nothing today.
# QUEUE_CACHE_TTL_SECONDS=
# QUEUE_RECOMPUTE_SECONDS=

# Phase 12 (notifications)
# SMS_PROVIDER=mock
# REMINDER_SEND_HOUR_LOCAL=

# Phase 2 seeds/fixtures
# Guards the TEST-data seed runner. Leave unset in production.
# ALLOW_TEST_DATA=false
