# Mandi Sahayak frontend — environment template
#
# Copy to .env.local and adjust. Never commit the filled copy.
# The backend has its own template at server/.env.example.

# ---------------------------------------------------------------------------
# API location
# ---------------------------------------------------------------------------

# Where the client sends requests. Leave as /api/v1 so the browser talks to the
# same origin it loaded from: the session and CSRF cookies are SameSite=Lax and
# the backend ships no CORS middleware, so a cross-origin base URL will fail to
# authenticate. In development the Vite proxy forwards /api to the backend.
VITE_API_BASE_URL=/api/v1

# Where the dev/preview proxy forwards /api. Read by vite.config.js, not by the
# browser. Change this if the backend is not on port 3000.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Demo OTP — LOCAL DEVELOPMENT AND DEMOS ONLY
# ---------------------------------------------------------------------------
#
# No SMS provider is configured, so during a demo the OTP has to be readable
# somewhere. With these set, the OTP screen calls the backend's existing
# token-protected GET /dev/last-otp and shows the code on screen.
#
# This reveals the OTP; it does NOT skip verification. The code must still be
# submitted to POST /auth/otp/verify, which is the only thing that creates a
# session.
#
# Requirements on the backend side (server/.env):
#   DEMO_MODE=true
#   DEV_TOOLS_TOKEN=<the same value as VITE_DEV_OTP_TOKEN below>
#
# The server refuses to start with DEMO_MODE and NODE_ENV=production together,
# so this cannot be left on by accident in a real deployment. Leave both unset
# for anything resembling production.
VITE_DEMO_OTP=true
VITE_DEV_OTP_TOKEN=local-demo-token
